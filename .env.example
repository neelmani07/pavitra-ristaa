# Normally you do not edit this: run ./scripts/setup-local.sh to create .env with random secrets.
# To do it by hand, copy this file to .env and fill in the blanks. .env is git-ignored; never commit real values.
# Used by docker-compose.yml, and export them (or `set -a; source .env; set +a`) before running the jars.

# PostgreSQL
DB_USERNAME=pavitra_ristaa
DB_PASSWORD=
POSTGRES_PORT=5433
# Point the API and migration job at the compose database:
DB_URL=jdbc:postgresql://localhost:5433/pavitra_ristaa

# S3-compatible storage (MinIO). The secret must be at least 8 characters.
MEDIA_BUCKET=pavitra-media
MEDIA_ACCESS_KEY=
MEDIA_SECRET_KEY=
# The `local` profile already defaults to MEDIA_ENDPOINT=http://localhost:9000 and path-style access.

# Required by the API
JWT_SECRET=

# Razorpay (Subscriptions API with UPI Autopay / card e-mandate for recurring billing). Leave all three blank
# to use the built-in stub payment gateway instead (auto-approves every checkout, no real charge, no account
# needed) - see subscriptions/service/AutoApprovePaymentGateway.java. Get test-mode keys free, no KYC required,
# at https://dashboard.razorpay.com/app/keys after signing up at https://razorpay.com/signup - then set up a
# webhook (Settings > Webhooks) pointing at POST /api/v1/webhooks/razorpay with the "subscription.*" and
# "payment.failed" events, and copy its secret into RAZORPAY_WEBHOOK_SECRET. A public HTTPS URL is required for
# the webhook to reach you - for local dev, tunnel with e.g. `ngrok http 8080` and use the ngrok URL.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
